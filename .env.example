# Copy this file to .env and fill in the values from your HubSpot test account.
# The .env file is git-ignored and must never be committed.

# Private app access token (Settings > Integrations > Private Apps)
PRIVATE_APP_TOKEN=pat-

# objectTypeId of the NFL Team custom object, printed by scripts/create-object.js
OBJECT_TYPE_ID=2-XXXXX

# Optional - defaults to 3000
PORT=3000
